module(
    name = "ironman",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# --- Go ---
bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_ibm_sarama", "com_github_jackc_pgx_v5")

# --- OCI ---
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "tar.bzl", version = "0.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    digest = "sha256:611d30d7f6d9992c37b1e1a212eefdf1f7c671deb56db3707e24eb01da8c4c2a",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "distroless_base",
    "distroless_base_linux_amd64",
    "distroless_base_linux_arm64_v8",
)

# --- Java (Flink) ---
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_jvm_external", version = "6.7")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "org.apache.flink:flink-streaming-java:1.20.2",
        "org.apache.flink:flink-clients:1.20.2",
        "org.apache.flink:flink-connector-base:1.20.2",
        "org.apache.flink:flink-table-common:1.20.2",
        "org.apache.flink:flink-table-runtime:1.20.2",
        "org.apache.hadoop:hadoop-client-api:3.3.6",
        "org.apache.iceberg:iceberg-flink-runtime-1.20:1.9.2",
        "org.apache.flink:flink-connector-kafka:3.3.0-1.20",
        "com.fasterxml.jackson.core:jackson-databind:2.17.2",
        "junit:junit:4.13.2",
    ],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
